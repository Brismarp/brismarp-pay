# ---------------------------------------------------------------------------
# Brismar Pay — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA faça commit do arquivo .env com valores reais.
# ---------------------------------------------------------------------------

# --- Banco de dados ---
POSTGRES_USER=brismar
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=brismar_pay
# Host ports (change if 5432/6379 are already in use on this machine)
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://brismar:troque_esta_senha@localhost:5432/brismar_pay

# --- Redis / Filas ---
REDIS_URL=redis://localhost:6379
PAYMENT_STATE_TTL_SECONDS=86400
PAYMENT_EXPIRATION_MINUTES=30
RECONCILIATION_BATCH_SIZE=100
RECONCILIATION_INTERVAL_MS=300000
RECOVERY_WORKER_CONCURRENCY=5

# --- Autenticação ---
# Gere com: openssl rand -hex 64
JWT_SECRET=

# --- API ---
PORT=3001
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001/v1

# ---------------------------------------------------------------------------
# Integração Getnet — NÃO CONFIGURADA NESTA FASE.
# As variáveis abaixo são reservadas para quando a integração for autorizada
# e a documentação oficial da Getnet for consultada. Não preencher com
# valores inventados.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
ALLOW_SANDBOX_WEBHOOK=false
# O worker separado executa recuperação e conciliação; mantenha false em testes de unidade.
WORKER_LOG_LEVEL=log

# ---------------------------------------------------------------------------
# Asaas — processador real por baixo da marca Brismar Pay.
# Sandbox: https://api-sandbox.asaas.com  (token $aact_hmlg_)
# Produção: https://api.asaas.com         (token $aact_prod_)
# A chave NUNCA entra no git. Cole no .env local.
# Webhook: POST /v1/webhooks/asaas com header asaas-access-token = ASAAS_WEBHOOK_TOKEN
# ---------------------------------------------------------------------------
# PAYMENT_PROVIDER=asaas
# A chave começa com $ — use aspas simples no .env para o shell não expandir.
# ASAAS_API_KEY='$aact_hmlg_cole_a_chave_aqui'
# ASAAS_BASE_URL=https://api-sandbox.asaas.com
# ASAAS_WEBHOOK_TOKEN=
# ASAAS_TIMEOUT_MS=10000

# GETNET_BASE_URL=https://api-sbx.globalgetnet.com
# GETNET_TOKEN_URL=https://api-sbx.globalgetnet.com/authentication/oauth2/access_token
# GETNET_CLIENT_ID=
# GETNET_CLIENT_SECRET=
# GETNET_SELLER_ID=
# GETNET_ENVIRONMENT=sandbox
# GETNET_WEBHOOK_AUTH_MODE=token
# GETNET_WEBHOOK_SECRET=
# Caminhos abaixo são obrigatórios somente após confirmação documental do contrato Getnet.
# GETNET_PIX_CREATE_PATH=
# GETNET_PIX_GET_PATH=/payments/:id
# GETNET_PIX_CANCEL_PATH=/payments/:id/cancel
# GETNET_PIX_REFUND_PATH=/payments/:id/refund
# GETNET_PIX_CAPTURE_PATH=/payments/:id/capture
# GETNET_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# E-mail transacional. Sem SMTP_HOST a API só escreve o link no log.
# APP_WEB_URL em produção: https://app.brismarppay.com.br
# ---------------------------------------------------------------------------
APP_WEB_URL=http://localhost:3000
MAIL_FROM=Brismar Pay <nao-responda@brismarppay.com.br>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
